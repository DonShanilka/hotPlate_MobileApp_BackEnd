  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Register - Nimal Perera') {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "  pm.collectionVariables.unset('userId');",
          "  pm.collectionVariables.unset('restaurantId');",
          "  pm.collectionVariables.unset('driverId');",
          "  pm.collectionVariables.unset('orderId');",
          "  pm.collectionVariables.unset('token');",
          "pm.collectionVariables.set('driverIds', JSON.stringify([]));",
          "pm.collectionVariables.set('orderIds', JSON.stringify([]));",
          "} else if (pm.info.requestName.startsWith('Assign Driver to Order ')) {",
          "  const index = Number(pm.info.requestName.slice(-1)) - 1;",
          "  const driverIds = JSON.parse(pm.collectionVariables.get('driverIds') || '[]');",
          "  const orderIds = JSON.parse(pm.collectionVariables.get('orderIds') || '[]');",
          "  pm.collectionVariables.set('driverId', driverIds[index] || '');",
          "  pm.collectionVariables.set('orderId', orderIds[index] || '');",
          "} else if (['Set Order 1 to Delivering', 'Update Driver Location', 'Get Order Tracking'].includes(pm.info.requestName)) {",
          "  const orderIds = JSON.parse(pm.collectionVariables.get('orderIds') || '[]');",
          "  pm.collectionVariables.set('orderId', orderIds[0] || '');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(pm.info.requestName + ' returns a successful response', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  const response = pm.response.json();",
          "  const data = response.data;",
          "  if (pm.info.requestName === 'Register - Nimal Perera' && data?._id) pm.collectionVariables.set('userId', data._id);",
          "  if (pm.info.requestName === 'Login' && data?.token) {",
          "    pm.collectionVariables.set('token', data.token);",
          "    pm.collectionVariables.set('userId', data.user._id);",
          "  }",
          "  if (pm.info.requestName === 'Create - Spice Garden' && data?._id) pm.collectionVariables.set('restaurantId', data._id);",
          "  const rKey = {'Create - Pizza House':'pizzaRestaurantId','Create - Burger Hub':'burgerRestaurantId','Create - Rice Bowl':'riceRestaurantId'}[pm.info.requestName];",
          "  if (rKey && data?._id) pm.collectionVariables.set(rKey, data._id);",
          "if (['Create - Ruwan Silva', 'Create - Dilan Perera', 'Create - Tharindu Fernando', 'Create - Nuwan Jayasuriya'].includes(pm.info.requestName) && data?._id) {",
          "    const driverIds = JSON.parse(pm.collectionVariables.get('driverIds') || '[]');",
          "    driverIds.push(data._id);",
          "    pm.collectionVariables.set('driverIds', JSON.stringify(driverIds));",
          "  }",
          "  if (pm.info.requestName.startsWith('Create Order ') && data?._id) {",
          "    const orderIds = JSON.parse(pm.collectionVariables.get('orderIds') || '[]');",
          "    orderIds.push(data._id);",
          "    pm.collectionVariables.set('orderIds', JSON.stringify(orderIds));",
          "  }",
          "  if (pm.info.requestName.startsWith('Assign Driver to Order ')) {",
          "    pm.test('Driver is assigned to this order', function () {",
          "      pm.expect(data.driverId).to.exist;",
          "      pm.expect(data.status).to.eql('OUT_FOR_DELIVERY');",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
